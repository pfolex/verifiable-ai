{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pricing_version",
    "rate_card_id",
    "provider",
    "model_id",
    "currency",
    "input_per_million",
    "output_per_million",
    "cached_input_per_million",
    "cache_write_input_per_million"
  ],
  "properties": {
    "pricing_version": {
      "const": "1.0.0"
    },
    "rate_card_id": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "enum": [
        "openai",
        "groq"
      ]
    },
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "currency": {
      "const": "USD"
    },
    "input_per_million": {
      "type": "number",
      "minimum": 0
    },
    "output_per_million": {
      "type": "number",
      "minimum": 0
    },
    "cached_input_per_million": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "cache_write_input_per_million": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    }
  }
}
