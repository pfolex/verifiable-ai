{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pfolex/verifiable-ai/blob/main/schemas/aix-scorecard-v1.schema.json",
  "title": "Multidimensional AIX Scorecard v1 (EVAL-02 / EVAL-03)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "created_at",
    "dataset_manifest_sha256",
    "budget_contract",
    "entries",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "dataset_manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "budget_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device",
        "threads",
        "num_candidates",
        "max_new_tokens",
        "temperature"
      ],
      "properties": {
        "device": {
          "type": "string",
          "minLength": 1
        },
        "threads": {
          "type": "integer",
          "minimum": 1
        },
        "num_candidates": {
          "type": "integer",
          "minimum": 1
        },
        "max_new_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "temperature": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entry_id",
          "model_id",
          "checkpoint_sha256",
          "answer_source",
          "capability",
          "reliability",
          "latency_ms",
          "cost_and_energy",
          "resources"
        ],
        "properties": {
          "entry_id": {
            "type": "string",
            "minLength": 1
          },
          "model_id": {
            "type": "string",
            "minLength": 1
          },
          "checkpoint_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "answer_source": {
            "enum": [
              "neural_only",
              "arithmetic_repaired",
              "exact_solver",
              "retrieved",
              "external_teacher",
              "heuristic_control"
            ]
          },
          "capability": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "correct_samples",
              "total_samples",
              "accuracy_ratio",
              "per_domain_accuracy"
            ],
            "properties": {
              "correct_samples": {
                "type": "integer",
                "minimum": 0
              },
              "total_samples": {
                "type": "integer",
                "minimum": 1
              },
              "accuracy_ratio": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "per_domain_accuracy": {
                "type": "object",
                "additionalProperties": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          },
          "reliability": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "error_samples",
              "invalid_format_samples",
              "mean_verifier_confidence"
            ],
            "properties": {
              "error_samples": {
                "type": "integer",
                "minimum": 0
              },
              "invalid_format_samples": {
                "type": "integer",
                "minimum": 0
              },
              "mean_verifier_confidence": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          },
          "latency_ms": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "first_request_ms",
              "p50_ms",
              "p95_ms",
              "mean_ms"
            ],
            "properties": {
              "first_request_ms": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "p50_ms": {
                "type": "number",
                "minimum": 0
              },
              "p95_ms": {
                "type": "number",
                "minimum": 0
              },
              "mean_ms": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "cost_and_energy": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "total_cost_usd",
              "measured_energy_joules"
            ],
            "properties": {
              "total_cost_usd": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "measured_energy_joules": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          },
          "resources": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "physical_parameters",
              "active_parameters_per_token",
              "recurrent_steps",
              "mean_ponder_depth",
              "cached_cartridge_bytes"
            ],
            "properties": {
              "physical_parameters": {
                "type": "integer",
                "minimum": 1
              },
              "active_parameters_per_token": {
                "type": "integer",
                "minimum": 1
              },
              "recurrent_steps": {
                "type": "integer",
                "minimum": 1
              },
              "mean_ponder_depth": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "cached_cartridge_bytes": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
