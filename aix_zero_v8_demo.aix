synapse v8_multi_step_adapter(rank=16, layer=27, lr=0.005);

task ModularNumberTheory(kind="math") {
    prompt: "Q:(11+2)%3="
    solve_with aix_zero:v8(temperature=0.0);
    verified_branch: """
def solve():
    return 1
"""
    trap_branch: """
def solve():
    return 2
"""
    verify {
        assert solve() == 1;
    }
    plasticity v8_multi_step_adapter(steps=8, scale=0.006);
}

